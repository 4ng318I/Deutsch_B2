#!/bin/sh
# Verhindert Commits, die ausgelieferte Dateien ändern, ohne VERSION in sw.js zu erhöhen.
# Aktivieren (einmal pro Klon):  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
PY=python
command -v "$PY" >/dev/null 2>&1 || PY=python3
exec "$PY" tools/check_version.py --staged
